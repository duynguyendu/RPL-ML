CONTIKI_PROJECT = udp-client

BUFFER_SIZE ?= 4
SEND_RATE ?= 10
DAO_ACK ?= 1
RAMP_UP_DURATION ?= 60
GATHER_METRICS ?= 0
PACKET_SIZE ?= 32
RPL_OF ?= 1

ifeq ($(RPL_OF),0)
RPL_SUPPORTED_OF ?= rpl_of0
else ifeq ($(RPL_OF),2)
RPL_SUPPORTED_OF ?= rpl_mlof
else
RPL_SUPPORTED_OF ?= rpl_mrhof
endif

all: $(CONTIKI_PROJECT)

CFLAGS += -DQUEUEBUF_CONF_NUM=$(BUFFER_SIZE) -DRPL_CONF_WITH_DAO_ACK=$(DAO_ACK) -DSEND_RATE=$(SEND_RATE) -DRAMP_UP_DURATION=$(RAMP_UP_DURATION) -DGATHER_METRICS=$(GATHER_METRICS) -DPACKET_SIZE=$(PACKET_SIZE) -DRPL_OF=$(RPL_OF) -DRPL_CONF_SUPPORTED_OFS="{&$(RPL_SUPPORTED_OF)}"
ifeq ($(GATHER_METRICS), 1)
PROJECT_SOURCEFILES += metrics.c
endif

# z1 has a hardware AES engine (cc2420); drop the unused software aes-128.c.
MODULES_SOURCES_EXCLUDES += aes-128.c

CONTIKI = ../../contiki-ng
include $(CONTIKI)/Makefile.include
