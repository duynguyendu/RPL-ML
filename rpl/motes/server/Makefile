CONTIKI_PROJECT = udp-server

BUFFER_SIZE ?= 32
DAO_ACK ?= 1
RPL_OF ?= 1
NETWORK_SIZE ?= 30

all: $(CONTIKI_PROJECT)

CFLAGS += -DQUEUEBUF_CONF_NUM=$(BUFFER_SIZE) -DRPL_CONF_WITH_DAO_ACK=$(DAO_ACK) -DRPL_OF=$(RPL_OF) -DNETSTACK_MAX_ROUTE_ENTRIES=$(NETWORK_SIZE)

CONTIKI = ../../contiki-ng
include $(CONTIKI)/Makefile.include
