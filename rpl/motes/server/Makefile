CONTIKI_PROJECT = udp-server

BUFFER_SIZE ?= 16
DAO_ACK ?= 1
RPL_OF ?= 1
NETWORK_SIZE ?= 30

ifeq ($(RPL_OF),0)
RPL_SUPPORTED_OF ?= rpl_of0
else ifeq ($(RPL_OF),2)
RPL_SUPPORTED_OF ?= rpl_mlof
else
RPL_SUPPORTED_OF ?= rpl_mrhof
endif

all: $(CONTIKI_PROJECT)

CFLAGS += -DQUEUEBUF_CONF_NUM=$(BUFFER_SIZE) -DRPL_CONF_WITH_DAO_ACK=$(DAO_ACK) -DRPL_OF=$(RPL_OF) -DRPL_CONF_SUPPORTED_OFS="{&$(RPL_SUPPORTED_OF)}" -DNETSTACK_MAX_ROUTE_ENTRIES=$(NETWORK_SIZE)

CONTIKI = ../../contiki-ng
include $(CONTIKI)/Makefile.include
