  booktitle = {Proceedings of the 19th {{ACM International Symposium}} on {{Performance Evaluation}} of {{Wireless Ad Hoc}}, {{Sensor}}, \& {{Ubiquitous Networks}}},
  author = {Duenas Santos, Carlos Lester and Astudillo León, Juan Pablo and Mezher, Ahmad Mohamad and Cardenas Barrera, Julian and Meng, Julian and Castillo Guerra, Eduardo},
